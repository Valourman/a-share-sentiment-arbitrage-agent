{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streamlit-dashboard",
      "runtimeExecutable": "streamlit",
      "runtimeArgs": [
        "run",
        "app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true"
      ],
      "port": 8501
    },
    {
      "name": "static-web-server",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "server.py"
      ],
      "port": 8080
    }
  ]
}
